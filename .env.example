# Safe local defaults. Copy this file to .env; never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
POSTGRES_USER=revenue_sre
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=revenue_sre
DATABASE_URL=postgresql+asyncpg://revenue_sre:replace-with-a-local-password@localhost:5432/revenue_sre
# Container processes must use the Compose service hostname. URL-encode any
# reserved password characters, for example @ as %40.
DATABASE_URL_DOCKER=postgresql+asyncpg://revenue_sre:replace-with-a-local-password@db:5432/revenue_sre

# Keep execution off until signed webhooks, persistence, idempotency,
# merchant authentication, and approval verification are implemented.
EXECUTION_ENABLED=false

# Configure locally only when the corresponding integration is implemented.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Single-merchant webhook binding used by the current control plane. The
# account id comes from the signed Razorpay webhook envelope.
MERCHANT_ID=
RAZORPAY_ACCOUNT_ID=
WEBHOOK_MAX_BODY_BYTES=262144

# PostgreSQL worker safety limits. A failed worker's lease expires, allowing a
# different process to reclaim the job without Redis.
WORKER_MAX_ATTEMPTS=5
WORKER_LEASE_SECONDS=60
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_CAP_SECONDS=300
WORKER_ID=
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LOOP_ERROR_BACKOFF_SECONDS=5
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEALTH_MAX_STALENESS_SECONDS=20
WORKER_HEARTBEAT_PATH=.runtime/revenue-sre-worker.heartbeat
WORKER_METRICS_HOST=127.0.0.1
WORKER_METRICS_PORT=9101
