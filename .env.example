# Safe local defaults. Copy this file to .env; never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
POSTGRES_USER=revenue_sre
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=revenue_sre
DATABASE_URL=postgresql+asyncpg://revenue_sre:replace-with-a-local-password@localhost:5432/revenue_sre
# Container processes must use the Compose service hostname. URL-encode any
# reserved password characters, for example @ as %40.
DATABASE_URL_DOCKER=postgresql+asyncpg://revenue_sre:replace-with-a-local-password@db:5432/revenue_sre

# Keep execution off until signed webhooks, persistence, idempotency,
# merchant authentication, and approval verification are implemented.
EXECUTION_ENABLED=false
RAZORPAY_MCP_URL=https://mcp.razorpay.com/mcp
RAZORPAY_MCP_TIMEOUT_SECONDS=30

# Configure locally only when the corresponding integration is implemented.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Single-merchant webhook binding used by the current control plane. The
# account id comes from the signed Razorpay webhook envelope.
MERCHANT_ID=
RAZORPAY_ACCOUNT_ID=
WEBHOOK_MAX_BODY_BYTES=262144

# The frontend streams the saved TrueForge agent through Vite's local proxy.
TRUEFORGE_BASE_URL=http://127.0.0.1:8790
VITE_TRUEFORGE_BASE_URL=/trueforge
VITE_TRUEFORGE_AGENT_NAME=revenue-sre-local-mcp-test

# PostgreSQL worker safety limits. A failed worker's lease expires, allowing a
# different process to reclaim the job without Redis.
WORKER_MAX_ATTEMPTS=5
WORKER_LEASE_SECONDS=60
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_CAP_SECONDS=300
WORKER_ID=
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LOOP_ERROR_BACKOFF_SECONDS=5
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEALTH_MAX_STALENESS_SECONDS=20
WORKER_HEARTBEAT_PATH=.runtime/revenue-sre-worker.heartbeat
WORKER_METRICS_HOST=127.0.0.1
WORKER_METRICS_PORT=9101

# Deterministic incident detector. Tune with measured replay data before
# production; lower demo values belong only in an uncommitted local .env.
INCIDENT_CURRENT_WINDOW_MINUTES=5
INCIDENT_BASELINE_WINDOW_MINUTES=30
INCIDENT_MINIMUM_ATTEMPTS=20
INCIDENT_MINIMUM_FAILURES=5
INCIDENT_MINIMUM_FAILURE_RATE=0.20
INCIDENT_MINIMUM_RATE_INCREASE=0.10
INCIDENT_BASELINE_MULTIPLIER=2.0

# Recovery proposal safety boundary. Block 2 records approvals but never calls
# Razorpay; EXECUTION_ENABLED remains false until the restricted adapter exists.
RECOVERY_POLICY_VERSION=recovery-policy-v1
RECOVERY_MAX_PLAN_AMOUNT_SUBUNITS=1000000
RECOVERY_MAX_ACTIONS_PER_PLAN=20
RECOVERY_MAX_PLAN_LIFETIME_MINUTES=60
RECOVERY_PROPOSAL_COOLDOWN_MINUTES=15
RECOVERY_MAX_CUSTOMER_CONTACTS=1

# Read-only MCP investigation server used by TrueForge. Keep localhost defaults
# unless TrueForge runs in WSL or another container. When binding to 0.0.0.0,
# explicitly allow only the Windows host address that the client will use.
MCP_HOST=127.0.0.1
MCP_PORT=8010
MCP_ALLOWED_HOSTS=["127.0.0.1","127.0.0.1:*","localhost","localhost:*"]
MCP_ALLOWED_ORIGINS=[]
