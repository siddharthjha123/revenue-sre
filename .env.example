# Safe local defaults. Copy this file to .env; never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./revenue_sre.db

# Keep execution off until signed webhooks, persistence, idempotency,
# merchant authentication, and approval verification are implemented.
EXECUTION_ENABLED=false

# Configure locally only when the corresponding integration is implemented.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
